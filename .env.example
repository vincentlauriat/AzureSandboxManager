# Copy to .env and fill in. Never commit .env.
# On Azure these are App Settings, not a file.

# Shared secret required in the X-Sandbox-Token header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANDBOX_TOKEN=replace-me-with-a-long-random-string

# Azure scope to report on
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=my-resource-group

# Optional
COLLECT_INTERVAL_MINUTES=10
SNAPSHOT_DIR=/home/azure-sandbox-manager
PORT=8080
